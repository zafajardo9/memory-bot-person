generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
}

enum KnowledgeSourceType {
  NOTE
  FILE
  URL
}

enum KnowledgeSourceStatus {
  DRAFT
  PROCESSING
  APPROVED
  FAILED
  ARCHIVED
}

enum KnowledgeVersionStatus {
  QUEUED
  PROCESSING
  READY
  APPROVED
  FAILED
  ARCHIVED
}

enum KnowledgeJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id               String                   @id @default(uuid()) @db.Uuid
  email            String                   @unique @db.VarChar(255)
  name             String?                  @db.VarChar(100)
  password         String?                  @db.VarChar(255)
  role             UserRole                 @default(MEMBER)
  chats            Chat[]
  reservations     Reservation[]
  knowledgeSources KnowledgeSource[]        @relation("KnowledgeSourceCreator")
  approvedVersions KnowledgeSourceVersion[] @relation("KnowledgeVersionApprover")
  knowledgeAudits  KnowledgeAuditEvent[]
  knowledgeQueries KnowledgeQueryLog[]
  providerConfigs  AiProviderConfig[]       @relation("AIProviderConfigUpdater")
  knowledgeAiConfigs KnowledgeAiConfig[]    @relation("KnowledgeAIConfigUpdater")
  workspaceAiConfigs WorkspaceAiConfig[]    @relation("WorkspaceAIConfigUpdater")
  integrationCredentials IntegrationCredential[] @relation("IntegrationCredentialUpdater")
  aiSelection      UserAiSelection?
  agentSettings    UserAgentSettings?
  memories         UserMemory[]
  skills           UserSkill[]              @relation("UserSkills")
  agents           Agent[]
  webSearchUsage   WebSearchUsage[]

  @@map("User")
}

model Agent {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  slug               String                 @db.VarChar(60)
  name               String                 @db.VarChar(60)
  description        String                 @default("") @db.VarChar(240)
  avatar             String                 @default("spark") @db.VarChar(30)
  color              String                 @default("violet") @db.VarChar(30)
  mood               String                 @default("balanced") @db.VarChar(30)
  responseLength     String                 @default("balanced") @db.VarChar(30)
  customInstructions String                 @default("") @db.Text
  responseLayers     Json?                                                    // structured response layering: [{label, content}]
  providerId         String?                @db.VarChar(50)
  modelId            String?                @db.VarChar(200)
  enabledTools       String[]               @default(["knowledge", "memory", "web", "browser", "weather", "flights"])
  isDefault          Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats              Chat[]
  memories           UserMemory[]
  knowledgeSources   AgentKnowledgeSource[]
  knowledgeQueries   KnowledgeQueryLog[]

  @@unique([userId, slug])
  @@index([userId, isDefault])
  @@map("Agent")
}

model AgentKnowledgeSource {
  agentId  String          @db.Uuid
  sourceId String          @db.Uuid
  addedAt  DateTime        @default(now())
  agent    Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([agentId, sourceId])
  @@index([sourceId])
  @@map("AgentKnowledgeSource")
}

model UserAgentSettings {
  userId             String   @id @db.Uuid
  agentName          String   @default("Memory") @db.VarChar(60)
  mood               String   @default("balanced") @db.VarChar(30)
  responseLength     String   @default("balanced") @db.VarChar(30)
  customInstructions String   @default("") @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserAgentSettings")
}

model AiProviderConfig {
  providerId     String   @id @db.VarChar(50)
  encryptedValue String?  @db.Text
  enabled        Boolean  @default(false)
  defaultModelId String?  @db.VarChar(200)
  customModelIds String[] @default([])
  isCustom       Boolean  @default(false)
  label          String?  @db.VarChar(80)
  baseUrl        String?  @db.VarChar(500)
  updatedById    String   @db.Uuid
  updatedAt      DateTime @updatedAt
  updatedBy      User     @relation("AIProviderConfigUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("AIProviderConfig")
}

model KnowledgeAiConfig {
  id          String   @id @default("workspace") @db.VarChar(30)
  providerId  String   @db.VarChar(50)
  modelId     String   @db.VarChar(200)
  updatedById String   @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedBy   User     @relation("KnowledgeAIConfigUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("KnowledgeAIConfig")
}

model WorkspaceAiConfig {
  id                 String   @id @default("workspace") @db.VarChar(30)
  researchProviderId String   @db.VarChar(50)
  researchModelId    String   @db.VarChar(200)
  humanizerProviderId String? @db.VarChar(50)
  humanizerModelId    String? @db.VarChar(200)
  updatedById        String   @db.Uuid
  updatedAt          DateTime @updatedAt
  updatedBy          User     @relation("WorkspaceAIConfigUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("WorkspaceAIConfig")
}

model IntegrationCredential {
  integrationId String   @id @db.VarChar(80)
  encryptedValue String  @db.Text
  updatedById   String   @db.Uuid
  updatedAt     DateTime @updatedAt
  updatedBy     User     @relation("IntegrationCredentialUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("IntegrationCredential")
}

model UserAiSelection {
  userId     String   @id @db.Uuid
  providerId String   @db.VarChar(50)
  modelId    String   @db.VarChar(200)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("UserAISelection")
}

model Chat {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  messages      Json
  userId        String   @db.Uuid
  agentId       String   @db.Uuid
  researchDepth String?  @default("quick")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@map("Chat")
}

model Reservation {
  id                  String   @id @default(uuid()) @db.Uuid
  createdAt           DateTime @default(now())
  details             Json
  hasCompletedPayment Boolean  @default(false)
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("Reservation")
}

model KnowledgeSource {
  id               String                   @id @default(uuid()) @db.Uuid
  type             KnowledgeSourceType
  status           KnowledgeSourceStatus    @default(DRAFT)
  title            String                   @db.VarChar(200)
  canonicalUrl     String?                  @db.Text
  mimeType         String?                  @db.VarChar(150)
  tags             String[]                 @default([])
  crawlDepth       Int                      @default(0)
  crawlLimit       Int                      @default(1)
  createdById      String                   @db.Uuid
  currentVersionId String?                  @unique @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  lastIndexedAt    DateTime?
  archivedAt       DateTime?
  createdBy        User                     @relation("KnowledgeSourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions         KnowledgeSourceVersion[] @relation("KnowledgeSourceVersions")
  currentVersion   KnowledgeSourceVersion?  @relation("CurrentKnowledgeVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  jobs             KnowledgeIngestionJob[]
  audits           KnowledgeAuditEvent[]
  agents           AgentKnowledgeSource[]

  @@index([status, updatedAt])
  @@index([createdById])
}

model KnowledgeSourceVersion {
  id               String                  @id @default(uuid()) @db.Uuid
  sourceId         String                  @db.Uuid
  version          Int
  checksum         String                  @db.VarChar(64)
  status           KnowledgeVersionStatus  @default(QUEUED)
  originalContent  Bytes?
  extractedText    String?                 @db.Text
  metadata         Json?
  errorMessage     String?                 @db.Text
  embeddingModel   String?                 @db.VarChar(100)
  storageProvider  String?                 @db.VarChar(20)
  storageRef       String?                 @db.VarChar(255)
  approvedById     String?                 @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime                @default(now())
  source           KnowledgeSource         @relation("KnowledgeSourceVersions", fields: [sourceId], references: [id], onDelete: Cascade)
  currentForSource KnowledgeSource?        @relation("CurrentKnowledgeVersion")
  approvedBy       User?                   @relation("KnowledgeVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  chunks           KnowledgeChunk[]
  jobs             KnowledgeIngestionJob[]

  @@unique([sourceId, version])
  @@unique([sourceId, checksum])
  @@index([sourceId, status])
}

model KnowledgeChunk {
  id           String                      @id @default(uuid()) @db.Uuid
  versionId    String                      @db.Uuid
  ordinal      Int
  content      String                      @db.Text
  section      String?                     @db.VarChar(500)
  pageNumber   Int?
  sourceUrl    String?                     @db.Text
  tokenCount   Int
  embedding    Unsupported("vector(768)")?
  searchVector Unsupported("tsvector")?
  version      KnowledgeSourceVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, ordinal])
  @@index([versionId])
}

model KnowledgeIngestionJob {
  id             String                 @id @default(uuid()) @db.Uuid
  sourceId       String                 @db.Uuid
  versionId      String                 @db.Uuid
  status         KnowledgeJobStatus     @default(QUEUED)
  stage          String                 @default("queued") @db.VarChar(50)
  progress       Int                    @default(0)
  attempts       Int                    @default(0)
  idempotencyKey String                 @unique @db.VarChar(160)
  errorMessage   String?                @db.Text
  createdAt      DateTime               @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  source         KnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version        KnowledgeSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sourceId])
}

model KnowledgeAuditEvent {
  id        String           @id @default(uuid()) @db.Uuid
  actorId   String           @db.Uuid
  sourceId  String?          @db.Uuid
  action    String           @db.VarChar(80)
  metadata  Json?
  createdAt DateTime         @default(now())
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  source    KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId, createdAt])
  @@index([actorId, createdAt])
}

model KnowledgeQueryLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  chatId            String?  @db.Uuid
  agentId           String   @db.Uuid
  query             String   @db.VarChar(1000)
  retrievedChunkIds String[] @default([])
  resultCount       Int
  latencyMs         Int
  feedback          Int?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
}

model UserMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  agentId   String   @db.Uuid
  title     String   @db.VarChar(200)
  content   String   @db.Text
  tags      String[] @default([])
  category  String   @default("fact") @db.VarChar(50)
  priority  Int      @default(0)
  source    String   @default("manual") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, priority, updatedAt])
  @@index([agentId, priority, updatedAt])
  @@map("UserMemory")
}

model UserSkill {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  slug         String   @db.VarChar(40)
  name         String   @db.VarChar(60)
  description  String   @default("") @db.VarChar(200)
  instructions String   @db.Text
  enabled      Boolean  @default(true)
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("UserSkills", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
  @@map("UserSkill")
}

model WebSearchUsage {
  userId    String   @db.Uuid
  day       DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("WebSearchUsage")
}
