# Optional fallback/initial keys. Admins can configure providers later at /settings/ai.
GOOGLE_GENERATIVE_AI_API_KEY=****
OPENAI_API_KEY=****

# Also encrypts site-managed AI credentials. Rotating it requires replacing the saved site key.
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****
AUTH_TRUST_HOST=true

# Comma-separated accounts allowed to manage company knowledge and AI settings.
# Configure this before exposing a new deployment publicly.
ADMIN_EMAILS=admin@company.com

/*
 * The following keys below are automatically created and
 * added to your environment when you deploy on vercel
 */

# Instructions to create kv database here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a database here: https://vercel.com/docs/postgres
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional but recommended when POSTGRES_URL uses Prisma Accelerate. This value
# is used by Prisma CLI commands such as `pnpm db:deploy`, never by the app.
DIRECT_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Knowledge feature flags (enabled unless explicitly set to false)
KNOWLEDGE_MANAGEMENT_ENABLED=true
KNOWLEDGE_INDEXING_ENABLED=true
KNOWLEDGE_CHAT_ENABLED=true
# Development fallback only. Keep false in production so invalid AI credentials fail closed.
KNOWLEDGE_ALLOW_LOCAL_EMBEDDINGS=false
KNOWLEDGE_MAX_SOURCES=250
KNOWLEDGE_MAX_CONTEXT_TOKENS=1000000
