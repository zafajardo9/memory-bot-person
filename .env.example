# =============================================================================
# Kairo — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# --- Required ----------------------------------------------------------------
AUTH_SECRET=                              # Min 32 chars. Generate: openssl rand -base64 32
POSTGRES_URL=                             # PostgreSQL connection string (or prisma:// for Accelerate)
DIRECT_DATABASE_URL=                      # Direct PostgreSQL URL for migrations (needed when using Accelerate)
ADMIN_EMAILS=                             # Comma-separated emails promoted to ADMIN on login, e.g. you@company.com, ops@company.com

# --- Auth --------------------------------------------------------------------
# Set to "true" when hosting outside Vercel. On Vercel, trust is implied.
AUTH_TRUST_HOST=false

# --- AI Providers (at least one required) ------------------------------------
# Keys below are the environment fallback. Prefer storing keys in the DB via
# /settings/ai (encrypted with AUTH_SECRET) — site keys take priority.
# https://ai.google.dev
GOOGLE_GENERATIVE_AI_API_KEY=             # Also powers knowledge embeddings
OPENAI_API_KEY=                           # https://platform.openai.com/api-keys
AI_RESEARCH_MODEL_ENABLED=true            # Set false for emergency single-model fallback
ANTHROPIC_API_KEY=                        # https://console.anthropic.com/settings/keys
DEEPSEEK_API_KEY=                         # https://platform.deepseek.com/api_keys
MISTRAL_API_KEY=                          # https://console.mistral.ai/api-keys
GROQ_API_KEY=                             # https://console.groq.com/keys
ZHIPU_API_KEY=                            # https://open.bigmodel.cn/usercenter/apikeys

# --- ImageKit File Storage (optional) ----------------------------------------
# https://imagekit.io/dashboard → Developer options
IMAGEKIT_PRIVATE_KEY=                     # private_xxx
IMAGEKIT_URL_ENDPOINT=                    # https://ik.imagekit.io/your-id
IMAGEKIT_KNOWLEDGE_FOLDER=/knowledge      # Folder path for knowledge uploads

# --- Vercel Blob (optional) --------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Feature Toggles ---------------------------------------------------------
# Set to "false" to disable. All knowledge flags default to true.
KNOWLEDGE_MANAGEMENT_ENABLED=true
KNOWLEDGE_INDEXING_ENABLED=true
KNOWLEDGE_CHAT_ENABLED=true
# Keep unset/"false" in production: when true, failed Gemini embeddings silently
# fall back to a dev-only local hash embedding. Production should fail loudly.
KNOWLEDGE_ALLOW_LOCAL_EMBEDDINGS=false
USER_MEMORY_ENABLED=true
AUTO_MEMORY_ENABLED=false
CHAT_SKILLS_ENABLED=true                  # Defaults on; set false for emergency rollback

# --- Knowledge Limits --------------------------------------------------------
KNOWLEDGE_MAX_SOURCES=250
KNOWLEDGE_MAX_CONTEXT_TOKENS=1000000
KNOWLEDGE_MAX_SCANS_PER_HOUR=20           # Per-user hourly cap on scans/refreshes (single + bulk)

# --- Web Search -------------------------------------------------------------
WEB_SEARCH_ENABLED=false
# Provider mode: "tavily" (default), "tinyfish", or "both" to merge results from every configured provider.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=                           # Required when WEB_SEARCH_ENABLED=true and mode is tavily or both
TINYFISH_API_KEY=                         # Required when WEB_SEARCH_ENABLED=true and mode is tinyfish; optional for "both"
WEB_SEARCH_MAX_DAILY=100
WEB_PAGE_MAX_CHARACTERS=12000

# --- Agent Browser -----------------------------------------------------------
# Defaults to false in production. Set to "true" to enable.
# Required for knowledge URL ingestion: JS-rendered pages (SPAs) that a plain
# HTTP fetch cannot read fall back to this headless browser.
AGENT_BROWSER_ENABLED=false
AGENT_BROWSER_BINARY_PATH=

# --- User Memory -------------------------------------------------------------
USER_MEMORY_MAX_ENTRIES=200
USER_MEMORY_CACHE_TTL_MS=30000
