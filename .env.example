# =============================================================================
# Kairo — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# --- Required ----------------------------------------------------------------
AUTH_SECRET=                              # Min 32 chars. Generate: openssl rand -base64 32
POSTGRES_URL=                             # PostgreSQL connection string (or prisma:// for Accelerate)
DIRECT_DATABASE_URL=                      # Direct PostgreSQL URL for migrations (needed when using Accelerate)

# --- AI Providers (at least one required) ------------------------------------
# https://ai.google.dev
GOOGLE_GENERATIVE_AI_API_KEY=

# --- ImageKit File Storage (optional) ----------------------------------------
# https://imagekit.io/dashboard → Developer options
IMAGEKIT_PUBLIC_KEY=                      # public_xxx
IMAGEKIT_PRIVATE_KEY=                     # private_xxx
IMAGEKIT_URL_ENDPOINT=                    # https://ik.imagekit.io/your-id
IMAGEKIT_KNOWLEDGE_FOLDER=/knowledge      # Folder path for knowledge uploads

# --- Vercel Blob (optional) --------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Feature Toggles ---------------------------------------------------------
# Set to "false" to disable. All knowledge flags default to true.
KNOWLEDGE_MANAGEMENT_ENABLED=true
KNOWLEDGE_INDEXING_ENABLED=true
KNOWLEDGE_CHAT_ENABLED=true
KNOWLEDGE_ALLOW_LOCAL_EMBEDDINGS=false
USER_MEMORY_ENABLED=true
AUTO_MEMORY_ENABLED=false

# --- Knowledge Limits --------------------------------------------------------
KNOWLEDGE_MAX_SOURCES=250
KNOWLEDGE_MAX_CONTEXT_TOKENS=1000000

# --- Web Search (Tavily) -----------------------------------------------------
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_DAILY=100
WEB_PAGE_MAX_CHARACTERS=12000

# --- Agent Browser -----------------------------------------------------------
# Defaults to false in production. Set to "true" to enable.
AGENT_BROWSER_ENABLED=false
AGENT_BROWSER_BINARY_PATH=

# --- User Memory -------------------------------------------------------------
USER_MEMORY_MAX_ENTRIES=200
USER_MEMORY_CACHE_TTL_MS=30000
